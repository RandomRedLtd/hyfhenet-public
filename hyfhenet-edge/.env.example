# Copy this file to .env before using docker compose.
# Edit HYFHENET_ZIGBEE_HOST for the target edge device.

# Image/build settings. Keep INSTALL_FHE_DEPS=false for the lightweight gateway image.
HYFHENET_IMAGE=
HYFHENET_GATEWAY_IMAGE=hyfhenet-edge-gateway:latest
HYFHENET_CAPTURE_IMAGE=hyfhenet-edge-capture:latest
HYFHENET_REPORT_IMAGE=hyfhenet-edge-report:latest
HYFHENET_INSTALL_FHE_DEPS=false
HYFHENET_GATEWAY_INSTALL_FHE_DEPS=false
HYFHENET_CAPTURE_INSTALL_FHE_DEPS=false
HYFHENET_REPORT_INSTALL_FHE_DEPS=false
HYFHENET_GATEWAY_INSTALL_REPORT_DEPS=false
HYFHENET_CAPTURE_INSTALL_REPORT_DEPS=false
HYFHENET_REPORT_INSTALL_REPORT_DEPS=true
# FHE builds install required native build tools automatically.
# Only enable this separately for unusual non-FHE source builds.
HYFHENET_INSTALL_BUILD_DEPS=false
# Optional private EDF SDK install for edf-sdk-live Docker runs.
# Leave 3.12 for normal builds; set python:3.13-slim-bookworm when installing service-sdk-python.
HYFHENET_PYTHON_IMAGE=python:3.12.3-slim-bookworm
HYFHENET_INSTALL_EDF_SERVICE_SDK=false
HYFHENET_GATEWAY_INSTALL_EDF_SERVICE_SDK=false
HYFHENET_EDF_SERVICE_SDK_PACKAGE=service-sdk-python

# MQTT/Zigbee2MQTT broker reachable from the container.
# Docker Desktop: host.docker.internal is usually correct.
# Linux MiniPC/Raspberry Pi: use the broker LAN IP, a Compose service name, or host.docker.internal with the host-gateway mapping in docker-compose.yml.
HYFHENET_ZIGBEE_HOST=host.docker.internal
HYFHENET_ZIGBEE_PORT=1883
HYFHENET_ZIGBEE_TOPIC=zigbee2mqtt/#
HYFHENET_ZIGBEE_TOPIC_PREFIX=zigbee2mqtt/
HYFHENET_ZIGBEE_LISTEN_SECONDS=600
HYFHENET_ZIGBEE_CLIENT_ID=hyfhenet-edge-gateway
HYFHENET_CAPTURE_CLIENT_ID=hyfhenet-edge-capture
HYFHENET_ZIGBEE_USERNAME=
HYFHENET_ZIGBEE_PASSWORD=
HYFHENET_ZIGBEE_TLS=false
HYFHENET_ZIGBEE_CA_CERT=
HYFHENET_ZIGBEE_CLIENT_CERT=
HYFHENET_ZIGBEE_CLIENT_KEY=
HYFHENET_ZIGBEE_TLS_INSECURE=false

# EDF service SDK mode. Install/configure the private service_sdk_python package
# and set the environment variables expected by DeviceApi.from_env().
DATALOGGER_GATEWAY_URL=
DATALOGGER_GATEWAY_TOKEN=
HYFHENET_EDF_SDK_STREAMS=TEMPERATURE,POWER,APPARENT_POWER,METER_INDEXES
HYFHENET_EDF_SDK_LISTEN_SECONDS=600
HYFHENET_EDF_SDK_DEFAULT_DEVICE_ID=edf_virtual_datalogger
HYFHENET_EDF_SDK_DEFAULT_DEVICE_ROLE=smart_plug
HYFHENET_EDF_SDK_REGISTER_UNKNOWN_DEVICES=true
HYFHENET_EDF_SDK_INCLUDE_UNSUPPORTED_FIELDS=false
# POWER is treated as plug power. APPARENT_POWER/METER_INDEXES are treated as meter values.
# Example when POWER should also be treated as a household meter instead of plug power:
# HYFHENET_EDF_SDK_STREAM_FIELD_MAP=POWER=household_power_w
HYFHENET_EDF_SDK_STREAM_FIELD_MAP=

# Optional remote FHE API settings. Leave blank when only local gateway behavior is being tested.
FHE_URL=https://hyfhe.net
FHE_API=
HYFHENET_FHE_API_URL=
HYFHENET_FHE_API_KEY=
HYFHENET_FHE_CLIENT_CERT=
HYFHENET_FHE_CLIENT_KEY=
HYFHENET_FHE_CA_BUNDLE=
# Optional override for backend model bundle selection. Leave blank for auto-detect.
# Supported backend bundles are x86_64 and aarch64.
HYFHENET_FHE_ARCHITECTURE=
HYFHENET_FHE_ALLOW_INSECURE_HTTP=false
# Optional FHE runtime optimization controls.
# Keep async false for report runs; set true for live gateways when cloud calls are slow.
HYFHENET_FHE_ASYNC=false
HYFHENET_FHE_MAX_PENDING_REQUESTS=1
HYFHENET_FHE_ASYNC_DRAIN_TIMEOUT_SECONDS=0
HYFHENET_FHE_SAMPLE_INTERVAL_SECONDS=
# Comma-separated: forecast,nilm,cohort, all, or none.
HYFHENET_FHE_TASKS=

# Capture paths and default report input/output paths.
HYFHENET_CAPTURE_OUTPUT=artifacts/zigbee_mqtt_capture.csv
HYFHENET_CAPTURE_RUN_OUTPUT=artifacts/gateway_mqtt_capture
HYFHENET_REPORT_SOURCE=input
HYFHENET_REPORT_INPUT=data/zigbee_mqtt_capture.csv
HYFHENET_REPORT_CONFIG=configs/pilot_1_2_edge.json
HYFHENET_REPORT_OUTPUT=artifacts/edge_report
HYFHENET_REPORT_INTERVAL_SECONDS=5
HYFHENET_REPORT_BENCHMARK_RUNS=0
# Run remote FHE no more often than this many report seconds. Leave blank to run every tick.
HYFHENET_REPORT_FHE_SAMPLE_INTERVAL_SECONDS=
# Optional report-only task subset, for example forecast or forecast,nilm.
HYFHENET_REPORT_FHE_TASKS=
HYFHENET_REPORT_FHE_ASYNC=false
HYFHENET_REPORT_FHE_MAX_PENDING_REQUESTS=1
HYFHENET_REPORT_FHE_ASYNC_DRAIN_TIMEOUT_SECONDS=0
# Set to true to use the existing edge model in reports instead of fitting report-local models.
HYFHENET_REPORT_SKIP_TRAINING=false
# Optional existing model JSON path inside the container; defaults to the configured edge model.
HYFHENET_REPORT_EDGE_MODEL_PATH=
# Set to false on slow edge devices when MP4 walkthrough videos are not needed.
HYFHENET_REPORT_VIDEOS=false
